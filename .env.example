# Copy to .env (scripts/setup.py creates .env with a random JWT_SECRET automatically). .env is gitignored.

# Signs session tokens. Leave unset only for throwaway runs: a random secret is then generated per process.
JWT_SECRET=

# Network binding. Default is loopback only; 0.0.0.0 exposes an open-registration API + /ws to the LAN.
# BP_HOST=127.0.0.1
# BP_PORT=8000

# Slovak-source speech model: a faster-whisper model name or a CTranslate2 directory.
# Default: ct2_models/whisper-small-sk (Slovak-tuned small, made by scripts/setup.py), else large-v3-turbo.
# See documentation/model_evaluation_2026-09.md for the measurements.
# BP_SK_STT_MODEL=large-v3-turbo

# Development only: create a test@example.com / password account on an empty database.
# BP_DEMO_USER=1

# Google login (optional).
# GOOGLE_CLIENT_ID=

# Where Whisper models are cached (default: ~/.cache/huggingface).
# HF_HOME=
