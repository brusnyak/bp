name: ci

on:
  push:
    branches: ["**"]
  pull_request:

permissions:
  contents: read

jobs:
  test:
    name: ${{ matrix.os }} / py${{ matrix.python }}
    runs-on: ${{ matrix.os }}
    timeout-minutes: 60
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-latest, macos-latest, windows-latest]
        python: ["3.11"]
    env:
      PYTHONUTF8: "1"
      HF_HOME: ${{ github.workspace }}/.hf-cache
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.python }}
          cache: pip
          cache-dependency-path: requirements*.txt
      - name: Cache models (HF hub + converted MT models)
        uses: actions/cache@v4
        with:
          path: |
            .hf-cache
            ct2_models
          key: models-${{ runner.os }}-${{ hashFiles('backend/mt/convert_opus_mt_to_ct2.py', 'scripts/convert_models.py', 'requirements-convert.txt') }}
      # The same one command a user runs: venv + deps + .env + certs + Piper voices + MT conversion.
      - name: Setup
        run: python scripts/setup.py --dev --no-npm
      - name: Tests
        shell: bash
        run: |
          if [ "$RUNNER_OS" = "Windows" ]; then PY=.venv/Scripts/python.exe; else PY=.venv/bin/python; fi
          $PY -m pytest test/hardware_test.py test/vad_tests.py test/mt_model_tests.py test/backend_api_tests.py test/backend_auth_tests.py test/security_tests.py -q
      - name: Dependency audit (informational: transformers 4.x CVEs are fixed only in 5.x)
        continue-on-error: true
        shell: bash
        run: |
          if [ "$RUNNER_OS" = "Windows" ]; then PY=.venv/Scripts/python.exe; else PY=.venv/bin/python; fi
          $PY -m pip install pip-audit
          $PY -m pip_audit --path "$($PY -c 'import sysconfig;print(sysconfig.get_paths()["purelib"])')" --progress-spinner off
