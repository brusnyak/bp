# CPU only (any OS): Whisper small int8. German ~11% word error (T4 numbers; CPU is slower but the model is the same).
# For better accuracy on a fast CPU use BP_STT_MODEL=large-v3-turbo (about 0.3-0.5x real time on an M1 Pro CPU).
BP_STT_MODEL=small
BP_PROSODY=1
# Speech cutting the live page preselects: no GPU: a recognition step costs more than the agreement step, so wait for pauses (the 2025-12 demo behaviour)
BP_DEFAULT_STRATEGY=phrase
