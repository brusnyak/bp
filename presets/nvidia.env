# NVIDIA GPU (Linux/Windows, CUDA 12): faster-whisper large-v3-turbo in float16 (T4: 0.4-0.5 s per 10 s clip, German 4.8% word error).
BP_STT_MODEL=large-v3-turbo
BP_DEVICE=cuda
BP_COMPUTE_TYPE=float16
BP_SK_STT_MODEL=ct2_models/whisper-large-v3-turbo-sk
BP_PROSODY=1
# Accurate streaming route, validated on a T4 through the real server (documentation/BENCHMARKS.md): English to German delay 3.89 s -> 1.56 s
# at equal accuracy; English to Slovak unchanged. Do not use a step below 1.0 s: 0.5 s collapses the queue (17.9 s delay).
BP_INCREMENTAL=1
BP_INCR_STEP_S=1.0
